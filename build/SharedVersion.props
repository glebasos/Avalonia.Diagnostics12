<Project DefaultTargets="Build"
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Product>AvaDiagnostics12</Product>
    <Version>12.1.0$(CIVersionSuffix)</Version>
    <Authors>glebasos</Authors>
    <Copyright>Copyright 2013-2025 &#169; The AvaloniaUI Project. Fork changes released under the same MIT license.</Copyright>
    <PackageProjectUrl>https://github.com/glebasos/Avalonia.Diagnostics12</PackageProjectUrl>
    <RepositoryUrl>https://github.com/glebasos/Avalonia.Diagnostics12</RepositoryUrl>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageDescription>Unofficial community fork of the legacy Avalonia.Diagnostics in-process DevTools, updated to run against Avalonia 12. Provides the classic AttachDevTools() window for inspecting the visual tree, styles, properties and events of an Avalonia application. Not affiliated with or endorsed by the AvaloniaUI project.</PackageDescription>
    <PackageTags>avalonia;avaloniaui;devtools;diagnostics;debugging;visual tree;inspector</PackageTags>
    <PackageReleaseNotes>https://github.com/glebasos/Avalonia.Diagnostics12/releases</PackageReleaseNotes>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <!-- Signing with AvaloniaUI's public snk is required, not cosmetic: Avalonia 12 grants access to
         its internals via InternalsVisibleTo("Avalonia.Diagnostics", PublicKey=<this key>), and the
         code uses those internals (InputManager, IRenderer, IClassesChangedListener). Dropping the
         key or renaming the assembly fails the build with CS0122. -->
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)/avalonia.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <!-- Symbols + Source Link: this is a debugging tool, so consumers who hit a bug in it need to be
         able to step into it. Emits a .snupkg alongside the .nupkg, pushed to the same feed. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Normalises absolute source paths in Release packs (which is what gets published) while
         leaving local Debug builds alone. Source Link resolves the sources from GitHub instead. -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and '$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- PackagePath pins the cased name so it matches PackageReadmeFile regardless of the
         on-disk casing (README.md on a case-insensitive filesystem). -->
    <None Include="$(MSBuildThisFileDirectory)/../README.md" Pack="true" PackagePath="readme.md" Visible="false" />
  </ItemGroup>

</Project>
